# Copy to .env and fill in. Every script sources this file (and .state.env, which the
# scripts write with generated IDs such as KB_UUID and APP_ID).

# ---- DigitalOcean credentials ------------------------------------------------
# Full-access API token used by the setup scripts and by the curator agent
# (creates the KB, starts indexing jobs, deploys the app).
DO_API_TOKEN=dop_v1_replace_me
# Scoped token with only "GenAI: read" for the chatbot's runtime retrieval calls.
# Leave empty to reuse DO_API_TOKEN (fine for a demo, not for production).
DO_API_TOKEN_READ=
# Serverless Inference model access key (Gradient AI Platform -> Model Access Keys).
MODEL_ACCESS_KEY=doo_v1_replace_me
# Project to create resources in. Leave empty to use the account's default project.
DO_PROJECT_ID=

# ---- Spaces (backing store for the knowledge base) ---------------------------
SPACES_REGION=nyc3
SPACES_BUCKET=doctl-kb-docs-replace-me        # must be globally unique
SPACES_PREFIX=docs
SPACES_ACCESS_KEY=DO00REPLACEME
SPACES_SECRET_KEY=replace_me

# ---- Gradient Knowledge Base -------------------------------------------------
KB_NAME=doctl-support-kb
KB_REGION=tor1
# Optional: embedding model UUID. Leave empty to auto-select "GTE Large" from
# `doctl gradient list-models`.
KB_EMBEDDING_MODEL_UUID=

# ---- GitHub / app repo --------------------------------------------------------
GITHUB_OWNER=hgonzalez-do
APP_REPO=doctl-support-bot
# This repo (the agent clones it for curator/ tooling). Change if you fork under another name.
CURATOR_REPO=managed-agents-kb-curator-demo
# Local clone of the app repo (used for the initial docs upload and demo rewind).
APP_REPO_PATH=../doctl-support-bot

# ---- App Platform -------------------------------------------------------------
APP_NAME=doctl-support-bot
APP_REGION=nyc
# github = deploy on every push (requires GitHub linked to your DO account in App Platform)
# git    = clone the public repo URL (no GitHub link needed; no auto-redeploy)
APP_SOURCE=github
# DO-hosted open model for the chatbot (any chat model from GET https://inference.do-ai.run/v1/models)
INFERENCE_MODEL=llama-4-maverick

# ---- Managed Agent (Open Harness) ---------------------------------------------
AGENT_NAME=doctl-docs-curator
# Sandbox size. Current catalog: GET https://api.digitalocean.com/v2/agents/sessions/sandbox/sizes
AGENT_SIZE=mars-2vcpu-4gb
# DO-hosted model the coding agent itself uses, served by Serverless Inference with MODEL_ACCESS_KEY.
AGENT_MODEL=deepseek-v4-pro
# Weekly, Mondays 09:00 in AGENT_TIMEZONE (IANA name).
AGENT_CRON="0 9 * * 1"
AGENT_TIMEZONE=UTC
# Where each run's final report goes: email | slack | none
OUTPUT_MODE=email
OUTPUT_EMAIL=you@example.com
OUTPUT_SLACK_WEBHOOK=
# Also create a GitHub webhook trigger (fires on "release published" events): true | false
TRIGGER_WEBHOOK=false
# Optional: lock the agent to ONE repo at the credential level. A GitHub fine-grained PAT
# (Settings -> Developer settings -> Fine-grained tokens) with access to only
# GITHUB_OWNER/APP_REPO and "Contents: read and write". Leave empty to use the team's
# account-wide GitHub OAuth connection (doctl agent auth github).
GITHUB_FINE_GRAINED_PAT=
# Folder containing the doctl *beta* binary (has `doctl agent`). Leave empty if it is on PATH.
DOCTL_BETA_DIR=
